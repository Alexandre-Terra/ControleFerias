# Copie para .env e ajuste os valores.

# Banco de dados.
# Local (desenvolvimento): SQLite.
DATABASE_URL=sqlite:///local.db
# Produção (Railway): o plugin de Postgres injeta a connection string via
# referência de variável (${{ Postgres.DATABASE_URL }} no painel do serviço).
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco

# Chave para sessões/CSRF do Flask (gere uma aleatória em produção).
SECRET_KEY=troque-esta-chave-em-producao

# Admin via ambiente (recomendado em produção). No deploy, `flask bootstrap-admin`
# (parte do startCommand) garante este admin: cria se não existir e, a cada deploy,
# RESSINCRONIZA a senha com ADMIN_SENHA e reativa/promove a conta. Útil para
# recuperar acesso — basta trocar ADMIN_SENHA e refazer o deploy.
# Sem fallback: se ADMIN_EMAIL ou ADMIN_SENHA ficarem vazios, o comando é no-op.
# ADMIN_SENHA precisa ter ao menos 6 caracteres (deploy falha se for menor).
# Atenção: a senha é redefinida a cada deploy — uma senha trocada na UI será
# sobrescrita pelo valor de ADMIN_SENHA no próximo deploy.
ADMIN_EMAIL=admin@exemplo.com
ADMIN_NOME=Admin
ADMIN_SENHA=troque-esta-senha
#
# Alternativa pontual (sem ressincronizar a cada deploy): criar via CLI.
#   flask criar-gestor --email admin@exemplo.com --nome "Admin" --admin
# Depois o admin pode criar outros gestores pela própria UI (/gestores).

# Quantos dias antes do limite de gozo um período entra em "A vencer".
ALERTA_A_VENCER_DIAS=60
