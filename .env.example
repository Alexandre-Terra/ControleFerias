# Copie para .env e ajuste os valores.

# Banco de dados.
# Local (desenvolvimento): SQLite.
DATABASE_URL=sqlite:///local.db
# Produção (Railway): o plugin de Postgres injeta a connection string via
# referência de variável (${{ Postgres.DATABASE_URL }} no painel do serviço).
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/banco

# Chave para sessões/CSRF do Flask (gere uma aleatória em produção).
SECRET_KEY=troque-esta-chave-em-producao

# O primeiro administrador é criado via CLI, NÃO por variável de ambiente:
#   flask criar-gestor --email admin@exemplo.com --nome "Admin" --admin
# Depois ele pode criar outros gestores pela própria UI (/gestores).

# Quantos dias antes do limite de gozo um período entra em "A vencer".
ALERTA_A_VENCER_DIAS=60
